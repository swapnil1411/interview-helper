  "narrative": {
    "northStar": "The Study Notebook",
    "overview": "PrepHub looks like a well-kept notebook: warm off-white paper, near-black ink, and one blue pen kept for whatever matters right now. It's a tool you come back to every day, so it stays calm. Density is moderate, surfaces are flat, and type does the organizing rather than decoration.\n\nThe blue is functional, not decorative. It marks progress, the active tab, checked items and the single next action. Amber is the only other voice: it flags starred and \"asked at Motorq\" items. Everything else is grey. Dark mode is the same notebook read under a desk lamp, with the same roles in inverted tones.",
    "keyCharacteristics": ["Only system fonts, with monospace for eyebrows, counters and numbers.", "One accent (Signal Blue) plus amber for priority. No decorative color.", "Flat bordered cards; lift appears only on hover.", "Desktop sidebar becomes a bottom tab bar with a pill indicator on mobile.", "Full light/dark parity through CSS custom properties on `:root` and `[data-theme='dark']`."],
    "rules": [
      { "name": "The One Pen Rule", "body": "Signal Blue means \"this is progress or the next action.\" If it's decorative, remove it.", "section": "colors" },
      { "name": "The Amber Means Priority Rule", "body": "Amber is only for starred or reported-asked content.", "section": "colors" },
      { "name": "The Numbers Are Mono Rule", "body": "Counts, percentages and step numbers use the mono stack.", "section": "typography" },
      { "name": "The Flat-At-Rest Rule", "body": "Nothing casts a shadow until it's hovered.", "section": "elevation" }
    ],
    "dos": ["**Do** use the CSS variables, never raw hex, so dark mode keeps working.", "**Do** keep a single Signal Blue action per view; other actions use Button Ink or ghost buttons.", "**Do** render numbers and counters in the mono stack.", "**Do** keep cards flat with a 1px border and 12px radius."],
    "donts": ["**Don't** add web fonts. The system stack is deliberate.", "**Don't** use Signal Blue or amber decoratively.", "**Don't** add resting shadows or gradients to cards.", "**Don't** ship motion that ignores `prefers-reduced-motion`."]
  }
